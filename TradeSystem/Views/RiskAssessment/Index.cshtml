@model TradeSystem.Models.RiskAssessment
@{
    ViewData["Title"] = "Risk Assessment";
}
<div class="container mt-4">
    <h2>Collective Risk Assessment</h2>
    <p class="text-muted">Select a Letter of Credit to assess risk collectively across its LC, related BGs, and linked Trade Documents.</p>

    <form asp-action="Index" method="post" class="card p-3 shadow-sm border-0 mb-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="row g-3 align-items-end">
            <div class="col-md-7">
                <label class="form-label">Letter of Credit</label>
                <select id="lcId" name="lcId" class="form-select" asp-items="ViewBag.LCs">
                    <option value="">-- Select LC --</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Analyze</button>
            </div>
        </div>
    </form>

    @if (Model != null)
    {
        var status = ((string, string))ViewBag.RiskStatus;
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">
                    Risk Score:
                    <strong>@Model.RiskScore.ToString("0.00")</strong> / 100
                    <span class="badge @status.Item2 ms-2">@status.Item1</span>
                </h5>
                <p class="mb-1">Reference: @Model.TransactionReference</p>
                <p class="mb-1">LC Id: @(Model.LcId?.ToString() ?? "-")</p>

                <h6 class="mt-3">Factors</h6>
                <pre class="bg-light p-3 border rounded">@Model.RiskFactors</pre>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}