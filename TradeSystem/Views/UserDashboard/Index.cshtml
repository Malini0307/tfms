@{
    ViewData["Title"] = "User Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <h2 class="mb-4">
        Welcome, <span class="fw-semibold" style="color: #6610f2;">@ViewBag.UserName</span>
    </h2>    
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body"><h5 class="card-title">Letter of Credit</h5><p class="card-text">Open and Track Letter of Credit. </p>
                    <a href="@Url.Action("Index", "LetterOfCredit")" class="btn fw-semibold" style="background-color: #7A2DF8; color: white;">Open LC</a>
                    </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body"><h5 class="card-title">Bank Guarantee</h5><p class="card-text">Request and Track Guarantees.</p>
                    <a href="@Url.Action("Index", "BankGuarantee")" class="btn fw-semibold" style="background-color: #7A2DF8; color: white;">Request guarantee</a>
                    </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body"><h5 class="card-title">Trade Documents</h5><p class="card-text">Upload and Manage documents linked to LC/BG.</p>
                    <a asp-controller="TradeDocument" asp-action="Index" class="btn fw-semibold" style="background-color: #7A2DF8; color: white;">Upload Documents</a>
                    </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body"><h5 class="card-title">Risk Scores</h5><p class="card-text">View transaction risk.</p>
                    <a asp-controller="RiskAssessment" asp-action="Index" class="btn fw-semibold" style="background-color: #7A2DF8; color: white;">Analyze Risk</a>
                    </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">Compliance</h5>
                    <p class="card-text">View compliance reports (read-only).</p>
                    <a asp-controller="Compliance" asp-action="Index" class="btn fw-semibold" style="background-color: #7A2DF8; color: white;">View Reports</a>
                </div>
                
            </div>
        </div>
    </div>
</div>

@section Footer {
    @await Html.PartialAsync("_Footer")
}
