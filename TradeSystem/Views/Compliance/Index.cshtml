@model IEnumerable<TradeSystem.Models.Compliance>
@{
    ViewData["Title"] = "Compliance Reports";
}

<div class="container mt-4">
    <h2>Compliance Reports</h2>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success">
            @TempData["Msg"]
        </div>
    }

    <table class="table table-hover table-bordered">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Reference</th>
                <th>Status</th>
                <th>Date</th>
                <th>Report State</th>
                <th>PDF</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.ComplianceId</td>
                    <td>@c.TransactionReference</td>
                    <td>@c.ComplianceStatus</td>
                    <td>@c.ReportDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (c.IsFinalized)
                        {
                            <span class="badge bg-success">Finalized</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Draft</span>
                        }
                    </td>
                    <td>
                        @if (c.IsFinalized && !string.IsNullOrEmpty(c.PdfPath))
                        {
                            <a href="@c.PdfPath" target="_blank" class="btn btn-sm btn-outline-primary">Download</a>
                        }
                        else
                        {
                            <span class="text-muted">Not available</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@c.ComplianceId" class="btn btn-sm btn-info">View</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@c.ComplianceId" class="btn btn-sm btn-warning">Edit</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Run" class="btn btn-danger">Run New Compliance</a>
    }
</div>
